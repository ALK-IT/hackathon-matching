# Wzór lokalnej konfiguracji backendu (#95). Skopiuj do backend/.env i zmień,
# co trzeba - plik .env nie trafia do repo (.gitignore).
#
# Lokalnie żadna zmienna nie jest wymagana: bez DATABASE_URL backend łączy się
# z bazą z docker-compose.yml. Na Railway DATABASE_URL jest OBOWIĄZKOWY - bez
# niego backend odmówi startu, zamiast udawać, że działa.
# Opis każdej wartości i jej granic: backend/app/settings.py.
#
# pytest też czyta ten plik - i odmówi startu, gdy DATABASE_URL nie wskazuje
# lokalnej bazy, bo testy kasują dane.

# Połączenie z bazą; postgres:// i postgresql:// są zamieniane na +asyncpg.
DATABASE_URL=postgresql+asyncpg://hackathon:hackathon@localhost:5432/hackathon_matching

# Adresy frontendu po przecinku, którym przeglądarka pozwoli czytać odpowiedzi.
# Puste = lista domyślna (localhost:5173 i front na Vercelu). "*" i "null"
# są zabronione.
CORS_ALLOWED_ORIGINS=
# Wzorzec dodatkowych adresów, np. podglądów z Vercela. Puste = wyłączone.
# Wzorzec wpuszczający obce strony (np. ".*") zatrzymuje start - jak "*".
CORS_ALLOWED_ORIGIN_REGEX=

# Limity (#57). Wartości spoza dozwolonych granic zatrzymują start.
MIN_TEAM_SIZE=1
MAX_TEAM_SIZE=20
MAX_TOTAL_SUBMISSIONS=3000
MAX_MATCHED_PARTICIPANTS=2000
